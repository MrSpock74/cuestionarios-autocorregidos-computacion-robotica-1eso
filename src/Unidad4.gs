  var r = d * Math.PI / 180, cx = 120, cy = 120, L = 78;
  var ex = cx + L * Math.sin(r), ey = cy - L * Math.cos(r);
  var hx = cx + (L + 12) * Math.sin(r), hy = cy - (L + 12) * Math.cos(r);
  var bx1 = cx + (L - 8) * Math.sin(r) + 9 * Math.cos(r), by1 = cy - (L - 8) * Math.cos(r) + 9 * Math.sin(r);
  var bx2 = cx + (L - 8) * Math.sin(r) - 9 * Math.cos(r), by2 = cy - (L - 8) * Math.cos(r) - 9 * Math.sin(r);
  function f(n) { return Math.round(n * 10) / 10; }
