// Una imagen de bloques (un bloque o un programa entero)
function blkFig_(name) {
  return '<div class="blkfig">' + BLK4_[name] + '</div>';
}

// Varias imágenes rotuladas A, B, C, D
function abcdFig_(names) {
  var letras = ['A', 'B', 'C', 'D'];
  return '<div class="abcd">' + names.map(function (n, i) {
    return '<div class="abcd-row"><span class="abcd-l">' + letras[i] + '</span><div class="abcd-b">' + BLK4_[n] + '</div></div>';
  }).join('') + '</div>';
}

function mezcla_(arr, rng) {
  return shuffleWith_(arr.slice(), rng);
}

// Cuatro números distintos, el primero es el correcto (los demás, candidatos)
function numerosDistintos_(correcto, candidatos) {
  var out = [correcto];
  candidatos.concat([correcto + 10, correcto + 20, correcto * 2, correcto + 1, correcto + 30]).forEach(function (c) {
    if (out.length < 4 && out.indexOf(c) === -1 && c > 0) { out.push(c); }
  });
  return out;
}

