// Fábrica: "¿cuál de estos bloques...?" con cuatro imágenes A, B, C, D
function abcd_(id, prompt, buenos, malos) {
  return {
    id: id, pool: 'b_abcd',
    gen: function (rng) {
      var bueno = pick_(buenos, rng);
      var lista = mezcla_([bueno].concat(mezcla_(malos, rng).slice(0, 3)), rng);
      var q = mcFixed_('x', 'x', prompt, ['A', 'B', 'C', 'D'], ['A', 'B', 'C', 'D'][lista.indexOf(bueno)]);
      q.fig = abcdFig_(lista);
      return q;
    }
  };
}

function bancoScratch_() {
